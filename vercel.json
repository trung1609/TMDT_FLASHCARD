{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/on-tap-cse703102/dist/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/tmdt",
      "destination": "/tmdt.html"
    },
    {
      "source": "/cse703102",
      "destination": "/tmdt.html"
    },
    {
      "source": "/bigdata",
      "destination": "/bigdata.html"
    },
    {
      "source": "/du-lieu-lon",
      "destination": "/bigdata.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(answers|pages)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
